{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color system adapter (one per design system)",
  "type": "object",
  "required": ["designSystem", "tokens", "output", "source"],
  "properties": {
    "designSystem": { "type": "string" },
    "tokens": { "type": "object", "description": "library token name -> rules.json intent", "additionalProperties": { "type": "string" } },
    "output": { "type": "object", "required": ["format", "file"] },
    "source": {
      "type": "object",
      "required": ["files", "styleFiles", "generated", "tokenUsage", "forbidden", "componentKinds"],
      "properties": {
        "tokenUsage": { "type": "array", "items": { "type": "object", "required": ["pattern"] } },
        "forbidden": { "type": "array", "items": { "type": "object", "required": ["id", "pattern", "message"] } },
        "componentKinds": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
