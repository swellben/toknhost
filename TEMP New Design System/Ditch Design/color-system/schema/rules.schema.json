{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color system rules (design-system agnostic)",
  "type": "object",
  "required": ["version", "modes", "roles", "intents", "constraints"],
  "properties": {
    "version": { "const": 1 },
    "modes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "roles": { "type": "object", "additionalProperties": { "type": "object", "required": ["slots"], "properties": { "slots": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } } },
    "intents": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z0-9-]+$" } },
    "constraints": {
      "type": "object",
      "properties": {
        "roleAccess": { "type": "object" },
        "intentScopes": { "type": "object" },
        "distinct": { "type": "array", "items": { "type": "object", "required": ["id", "subject", "mustDifferFrom", "severity"] } },
        "contrast": { "type": "array", "items": { "type": "object", "required": ["fg", "bg", "min"] } },
        "budget": { "type": "object" }
      }
    }
  }
}
