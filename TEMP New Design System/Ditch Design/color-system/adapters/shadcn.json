{
  "$schema": "../schema/adapter.schema.json",
  "designSystem": "shadcn/ui (Tailwind CSS v4)",
  "about": "Binds rules.json intents to shadcn token names and says how to find those tokens in source. Mappings only: no rules, no color values.",

  "tokens": {
    "background": "surface.page",
    "foreground": "text.default",
    "card": "surface.raised",
    "card-foreground": "text.default",
    "popover": "surface.raised",
    "popover-foreground": "text.default",
    "primary": "action.primary.fill",
    "primary-foreground": "action.primary.label",
    "secondary": "surface.subtle",
    "secondary-foreground": "text.default",
    "muted": "surface.subtle",
    "muted-foreground": "text.muted",
    "accent": "surface.subtle",
    "accent-foreground": "text.default",
    "destructive": "action.destructive.fill",
    "destructive-foreground": "action.destructive.label",
    "border": "border.divider",
    "input": "border.control",
    "ring": "focus.ring",
    "chart-1": "data.series.1",
    "chart-2": "data.series.2",
    "chart-3": "data.series.3",
    "chart-4": "data.series.4",
    "chart-5": "data.series.5",
    "sidebar": "surface.page",
    "sidebar-foreground": "text.default",
    "sidebar-primary": "action.primary.fill",
    "sidebar-primary-foreground": "action.primary.label",
    "sidebar-accent": "surface.subtle",
    "sidebar-accent-foreground": "text.default",
    "sidebar-border": "border.divider",
    "sidebar-ring": "focus.ring",
    "brand-secondary": "brand.accent.fill",
    "brand-secondary-foreground": "brand.accent.label",
    "brand-secondary-ink": "brand.accent.text",
    "brand-mark": "brand.mark.primary",
    "brand-mark-strong": "brand.mark.secondary",
    "brand-wordmark": "brand.wordmark",
    "success": "status.success.fill",
    "success-foreground": "status.success.label",
    "success-ink": "status.success.text",
    "warning": "status.warning.fill",
    "warning-foreground": "status.warning.label",
    "warning-ink": "status.warning.text",
    "error": "status.error.fill",
    "error-ink": "status.error.text",
    "info": "status.info.fill",
    "info-foreground": "status.info.label",
    "info-ink": "status.info.text"
  },

  "output": {
    "format": "css-variables",
    "file": "src/app/colors.generated.css",
    "paletteVarPrefix": "--palette-",
    "selectors": { "light": ":root", "dark": ".dark" },
    "tailwindThemeInline": { "enabled": true, "prefix": "--color-" },
    "figmaVariables": "color-system/generated/figma-variables.json",
    "tokenFile": { "path": "design/figma-variables.tokens.json", "modes": { "light": "light", "dark": "dark" } }
  },

  "source": {
    "files": ["src/**/*.{ts,tsx,js,jsx,mjs}"],
    "styleFiles": ["src/**/*.css"],
    "generated": ["src/app/colors.generated.css"],
    "tokenUsage": [
      {
        "about": "Tailwind utilities generated from --color-<token>, e.g. bg-primary, text-muted-foreground/80, hover:ring-ring.",
        "pattern": "(?<![\\w-])(?:bg|text|border(?:-[trblxyse])?|ring(?:-offset)?|outline|fill|stroke|decoration|from|via|to|shadow|caret|accent|divide|placeholder|inset-shadow|inset-ring)-(?<token>{tokens})(?:/\\d{1,3})?(?![\\w-])"
      },
      {
        "about": "Direct CSS variable references, e.g. var(--primary) inside arbitrary values or styles.",
        "pattern": "var\\(--(?<token>{tokens})\\)"
      }
    ],
    "forbidden": [
      { "id": "color-literal", "pattern": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?![0-9a-zA-Z_-])", "message": "Color literal. Use a theme token." },
      { "id": "color-function", "pattern": "(?<![\\w-])(?:rgba?|hsla?|oklch|oklab|lab|lch|hwb|color)\\(", "message": "Color function. Use a theme token." },
      { "id": "palette-reference", "pattern": "--palette-[a-z0-9-]+", "message": "Palette step used directly. Use a theme token." },
      { "id": "role-reference", "pattern": "--role-[a-z0-9.-]+", "message": "Role slot used directly. Use a theme token." },
      { "id": "framework-palette", "pattern": "(?<![\\w-])(?:bg|text|border|ring|outline|fill|stroke|decoration|from|via|to|shadow|caret|accent|divide|placeholder)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-\\d{2,3}(?![\\w-])", "message": "Tailwind default palette class. Use a theme token." },
      { "id": "framework-absolute", "pattern": "(?<![\\w-])(?:bg|text|border|ring|outline|fill|stroke|from|via|to|divide)-(?:black|white)(?:/\\d{1,3})?(?![\\w-])", "message": "Absolute black/white class. Use a theme token." }
    ],
    "componentKinds": {
      "action": [
        "src/components/ui/button.tsx",
        "src/components/ui/button-group.tsx",
        "src/components/ui/toggle.tsx",
        "src/components/ui/toggle-group.tsx",
        "src/components/ui/checkbox.tsx",
        "src/components/ui/radio-group.tsx",
        "src/components/ui/switch.tsx",
        "src/components/ui/slider.tsx",
        "src/components/ui/tabs.tsx",
        "src/components/ui/pagination.tsx",
        "src/components/ui/calendar.tsx",
        "src/components/ui/input-otp.tsx",
        "src/components/ui/select.tsx",
        "src/components/ui/combobox.tsx",
        "src/components/ui/command.tsx",
        "src/components/ui/dropdown-menu.tsx",
        "src/components/ui/context-menu.tsx",
        "src/components/ui/menubar.tsx",
        "src/components/ui/navigation-menu.tsx",
        "src/components/ui/sidebar.tsx",
        "src/components/ui/link.tsx"
      ],
      "data-viz": ["src/components/ui/chart.tsx", "src/components/charts/**"],
      "brand": ["src/components/brand/**"]
    }
  }
}
